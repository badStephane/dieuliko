# Copy to .env (read by the Makefile). Values below match docker-compose.yml.
DATABASE_URL=postgres://dieuliko:dieuliko@127.0.0.1:5433/dieuliko?sslmode=disable
HTTP_ADDR=127.0.0.1:8090
CORS_ORIGINS=http://localhost:3000
# Comma-separated reverse proxy IPs/CIDRs whose X-Forwarded-For is trusted (empty = none; 0.0.0.0/0 refused).
TRUSTED_PROXIES=
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
LOG_LEVEL=info
# Public URL of the web front, used in email links.
APP_BASE_URL=http://localhost:3000
# Outgoing email. Defaults target Mailpit (docker compose): read mails at http://localhost:8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# none | starttls | tls
SMTP_TLS=none
MAIL_FROM=Dieuliko <no-reply@dieuliko.local>
# Shared secret identifying the Next.js server (>= 32 chars, openssl rand -hex 32). Empty = disabled.
# Token-bearing calls share one larger bucket instead of the per-IP one.
INTERNAL_API_TOKEN=
INTERNAL_RATE_LIMIT_RPS=200
INTERNAL_RATE_LIMIT_BURST=400
# CV storage (S3-compatible). Defaults target SeaweedFS (docker compose); in production, e.g. R2:
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com and S3_REGION=auto. The bucket must exist.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=dieuliko-cvs
# Required by the API server (not by migrate/seed/admin). Development keys match docker-compose.yml.
S3_ACCESS_KEY=dieuliko
S3_SECRET_KEY=dieuliko-dev-secret
# Writing assistant (profile texts, cover letters) via Groq's OpenAI-compatible API, free tier.
# Create a key on https://console.groq.com (API Keys). Empty = the assistant answers "unavailable".
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Our own ceiling, under Groq's free-tier 30 requests/minute.
AI_REQUESTS_PER_MINUTE=25
